# ==============================================================================
# Database Connection (Supabase PostgreSQL Connection Pooler)
# ==============================================================================
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# ==============================================================================
# Backend & API Configuration
# ==============================================================================
# Local Development:
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Production on Vercel (Set in Vercel Environment Variables):
# BACKEND_URL: Used by Next.js /backend/* rewrite proxy to forward requests to Render
# NEXT_PUBLIC_API_URL: Used for server-side rendering fallback
BACKEND_URL="https://dharohar-setu-api.onrender.com"
# NEXT_PUBLIC_API_URL="https://dharohar-setu-api.onrender.com"

# ==============================================================================
# Administrative Credentials (Seeded on first backend boot)
# ==============================================================================
ADMIN_EMAIL="admin@dharohar.org"
ADMIN_PASSWORD="your_secure_admin_password"

# ==============================================================================
# Multimodal AI & Intelligence (Google Gemini API)
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET="generate_a_cryptographically_secure_random_string_here_min_32_chars"


